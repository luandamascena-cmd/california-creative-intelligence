# ===== Opção recomendada sem Google Cloud: Apps Script da própria planilha =====
# Veja apps-script/california-pauta.gs (a função configurar() gera os códigos). Com estas duas variáveis, as opções A e B são ignoradas.
APPS_SCRIPT_URL=https://script.google.com/macros/s/SEU_ID/exec
APPS_SCRIPT_TOKEN=

# ===== Planilha (opções A e B, via Google Cloud) =====
# ID da planilha (trecho entre /d/ e /edit na URL)
GOOGLE_SHEETS_ID=1Czltjygjb6NLeBpca4n05oZz-qfNWA0ciKPCx-eLxBY

# ===== Opção A: conta de serviço do Google Cloud, somente leitura =====
GOOGLE_SERVICE_ACCOUNT_EMAIL=dashboard-pauta@seu-projeto.iam.gserviceaccount.com
# Cole a private_key do JSON da conta de serviço, mantendo os \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ===== Opção B: chave de API (exige a planilha compartilhada como "qualquer pessoa com o link: leitor") =====
# GOOGLE_API_KEY=

# ===== Acesso à dashboard =====
# Senha única de acesso (mínimo 8 caracteres). Não reutilize senhas já expostas.
DASHBOARD_PASSWORD=
# Segredo para assinar as sessões (mínimo 32 caracteres). Gere com: openssl rand -base64 48
SESSION_SECRET=

# ===== Atualização =====
# Segredo compartilhado com o Google Apps Script (mínimo 16 caracteres)
WEBHOOK_SECRET=
# Intervalo de atualização automática no navegador (segundos, mínimo 15)
REFRESH_SECONDS=45
# Validade do cache no servidor (segundos, mínimo 10)
CACHE_TTL_SECONDS=30

# ===== Demonstração =====
# "demo" usa o snapshot em data/demo-snapshot.json, sem acessar o Google. Remova em produção.
# DATA_SOURCE=demo
